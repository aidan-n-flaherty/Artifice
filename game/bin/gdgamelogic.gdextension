[configuration]

entry_symbol = "gamelogic_library_init"
compatibility_minimum = 4.1

[libraries]

macos.debug = "res://bin/macos/libgdgamelogic.macos.template_debug.framework/libgdgamelogic.macos.template_debug"
macos.release = "res://bin/macos/libgdgamelogic.macos.template_release.framework/libgdgamelogic.macos.template_debug"
windows.debug.x86_32 = "res://bin/libgdgamelogic.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "res://bin/libgdgamelogic.windows.template_release.x86_32.dll"
windows.debug.x86_64 = "res://bin/libgdgamelogic.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libgdgamelogic.windows.template_release.x86_64.dll"
windows.debug.arm64 = "res://bin/libgdgamelogic.windows.template_debug.arm64.dll"
windows.release.arm64 = "res://bin/libgdgamelogic.windows.template_release.arm64.dll"
linux.debug.x86_32 = "res://bin/libgdgamelogic.linux.template_debug.x86_32.so"
linux.release.x86_32 = "res://bin/libgdgamelogic.linux.template_release.x86_32.so"
linux.debug.x86_64 = "res://bin/libgdgamelogic.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libgdgamelogic.linux.template_release.x86_64.so"
linux.debug.arm32 = "res://bin/libgdgamelogic.linux.template_debug.arm32.so"
linux.release.arm32 = "res://bin/libgdgamelogic.linux.template_release.arm32.so"
linux.debug.arm64 = "res://bin/libgdgamelogic.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/libgdgamelogic.linux.template_release.arm64.so"
linux.debug.rv64 = "res://bin/libgdgamelogic.linux.template_debug.rv64.so"
linux.release.rv64 = "res://bin/libgdgamelogic.linux.template_release.rv64.so"
android.debug.x86_64 = "res://bin/libgdgamelogic.android.template_debug.x86_64.so"
android.release.x86_64 = "res://bin/libgdgamelogic.android.template_release.x86_64.so"
android.debug.arm64 = "res://bin/libgdgamelogic.android.template_debug.arm64.so"
android.release.arm64 = "res://bin/libgdgamelogic.android.template_release.arm64.so"
ios.debug = "res://bin/ios/libgdgamelogic.ios.template_debug.universal.dylib"
ios.release = "res://bin/ios/libgdgamelogic.ios.template_release.universal.dylib"
web.debug.wasm32 = "res://bin/libgdgamelogic.web.template_debug.wasm32.wasm"
web.release.wasm32 = "res://bin/libgdgamelogic.web.template_release.wasm32.wasm"


[dependencies]
ios.debug = {
  "res://bin/ios/libgdgamelogic.ios.template_debug.universal.dylib": ""
}
ios.release = {
  "res://bin/ios/libgdgamelogic.ios.template_release.universal.dylib": ""
}